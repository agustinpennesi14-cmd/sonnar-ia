// ==================================================
// VOLUMEN
// ==================================================

void mostrarVolumen() {

  display.clearDisplay();


  // --------------------------------
  // Título
  // --------------------------------

  display.setTextSize(1);

  display.setCursor(
    45,
    0
  );

  display.print(
    "VOLUMEN"
  );


  // --------------------------------
  // Porcentaje
  // --------------------------------

  display.setTextSize(1);

  char texto[8];

  sprintf(
    texto,
    "%d%%",
    volumen
  );

  display.setCursor(
    54,
    9
  );

  display.print(texto);


  // --------------------------------
  // Barra
  // --------------------------------

  display.drawRoundRect(
    8,
    18,
    112,
    10,
    3,
    SSD1306_WHITE
  );


  int ancho =
    map(
      volumen,
      0,
      100,
      0,
      108
    );


  if (ancho > 0) {

    display.fillRoundRect(
      10,
      20,
      ancho,
      6,
      2,
      SSD1306_WHITE
    );
  }


  display.display();
}


// ==================================================
// LOOP VOLUMEN
// ==================================================

void volumenLoop() {

  // --------------------------------
  // SUBIR
  // --------------------------------

  if (digitalRead(BTN_UP) == LOW) {

    esperarSoltar(BTN_UP);

    volumen += 10;

    if (volumen > 100) {
      volumen = 100;
    }

    animacionVolumen();
  }


  // --------------------------------
  // BAJAR
  // --------------------------------

  if (digitalRead(BTN_DOWN) == LOW) {

    esperarSoltar(BTN_DOWN);

    volumen -= 10;

    if (volumen < 0) {
      volumen = 0;
    }

    animacionVolumen();
  }


  // --------------------------------
  // ENTER
  // --------------------------------

  if (digitalRead(BTN_ENTER) == LOW) {

    esperarSoltar(BTN_ENTER);

    animacionSalida();

    estado = MENU;

    mostrarMenu();
  }
}


// ==================================================
// ANIMACIÓN VOLUMEN
// ==================================================

void animacionVolumen() {

  display.clearDisplay();


  display.setTextSize(1);

  display.setCursor(
    45,
    0
  );

  display.print(
    "VOLUMEN"
  );


  char texto[8];

  sprintf(
    texto,
    "%d%%",
    volumen
  );


  display.setCursor(
    54,
    9
  );

  display.print(texto);


  // --------------------------------
  // Barra animada
  // --------------------------------

  display.drawRoundRect(
    8,
    18,
    112,
    10,
    3,
    SSD1306_WHITE
  );


  int objetivo =
    map(
      volumen,
      0,
      100,
      0,
      108
    );


  for (
    int ancho = 0;
    ancho <= objetivo;
    ancho += 4
  ) {

    display.fillRoundRect(
      10,
      20,
      ancho,
      6,
      2,
      SSD1306_WHITE
    );

    display.display();

    delay(10);
  }
}


// ==================================================
// SISTEMA
// ==================================================

void mostrarSistema() {

  display.clearDisplay();


  // --------------------------------
  // Título
  // --------------------------------

  display.setTextSize(1);

  display.setCursor(
    43,
    0
  );

  display.print(
    "SISTEMA"
  );


  // --------------------------------
  // Línea
  // --------------------------------

  display.drawLine(
    0,
    9,
    127,
    9,
    SSD1306_WHITE
  );


  // --------------------------------
  // Estado
  // --------------------------------

  display.setTextSize(2);

  const char* texto;

  if (invertido) {

    texto = "INVERTIDO";

  } else {

    texto = "NORMAL";
  }


  int16_t x1;
  int16_t y1;

  uint16_t w;
  uint16_t h;


  display.getTextBounds(
    texto,
    0,
    0,
    &x1,
    &y1,
    &w,
    &h
  );


  int x =
    (128 - w) / 2;


  display.setCursor(
    x,
    13
  );

  display.print(texto);


  display.display();
}


// ==================================================
// LOOP SISTEMA
// ==================================================

void sistemaLoop() {

  // --------------------------------
  // UP
  // --------------------------------

  if (digitalRead(BTN_UP) == LOW) {

    esperarSoltar(BTN_UP);

    invertido = !invertido;

    display.invertDisplay(
      invertido
    );

    mostrarSistema();
  }


  // --------------------------------
  // DOWN
  // --------------------------------

  if (digitalRead(BTN_DOWN) == LOW) {

    esperarSoltar(BTN_DOWN);

    invertido = !invertido;

    display.invertDisplay(
      invertido
    );

    mostrarSistema();
  }


  // --------------------------------
  // ENTER
  // --------------------------------

  if (digitalRead(BTN_ENTER) == LOW) {

    esperarSoltar(BTN_ENTER);

    animacionSalida();

    estado = MENU;

    mostrarMenu();
  }
}


