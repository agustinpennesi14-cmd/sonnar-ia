// ==================================================
// ESPERAR SOLTAR BOTÓN
// ==================================================

void esperarSoltar(
  int boton
) {

  delay(30);

  while (
    digitalRead(boton) == LOW
  ) {

    delay(5);
  }

  delay(30);
}
